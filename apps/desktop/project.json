{
  "name": "desktop",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/desktop/src",
  "projectType": "application",
  "tags": ["scope:app", "type:app", "platform:electron"],
  "targets": {
    "build-main": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/desktop/main",
        "main": "apps/desktop/src/main/main.ts",
        "tsConfig": "apps/desktop/tsconfig.main.json",
        "assets": [
          { "glob": "icon.png", "input": "apps/desktop/src/assets", "output": "assets" }
        ]
      }
    },
    "build-preload": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/desktop/preload",
        "main": "apps/desktop/src/preload/preload.ts",
        "tsConfig": "apps/desktop/tsconfig.preload.json",
        "assets": []
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/dist/apps/desktop/main",
        "{workspaceRoot}/dist/apps/desktop/preload"
      ],
      "dependsOn": [{ "target": "build", "projects": ["web"] }, "build-main", "build-preload"],
      "options": {
        "command": "node -e \"console.log('desktop build composed: main + preload + web bundle')\""
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "dependsOn": ["build-main", "build-preload"],
      "options": {
        "commands": [
          "nx serve web",
          "DEV_SERVER_URL=http://localhost:4200 electron dist/apps/desktop/main/src/main/main.js"
        ],
        "parallel": true
      }
    },
    "serve-electron": {
      "executor": "nx:run-commands",
      "dependsOn": ["build-main", "build-preload"],
      "options": {
        "command": "DEV_SERVER_URL=http://localhost:4200 electron dist/apps/desktop/main/src/main/main.js"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/desktop/jest.config.ts"
      }
    }
  }
}
