{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aquascape.dev/schemas/catalog-entry-v1.json",
  "title": "CatalogEntry",
  "description": "A single catalog entry. Stage 2 ships the `substrate` branch; later stages add tank / hardscape / plant / equipment / livestock under the same oneOf.",
  "oneOf": [{ "$ref": "#/$defs/SubstrateEntry" }],
  "$defs": {
    "HexColor": { "type": "string", "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$" },
    "CatalogEntryBase": {
      "type": "object",
      "required": ["catalog", "id", "version", "name", "kind"],
      "properties": {
        "catalog": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{0,63}$" },
        "version": { "type": "integer", "minimum": 1 },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "kind": { "type": "string", "minLength": 1 }
      }
    },
    "SubstrateEntry": {
      "allOf": [{ "$ref": "#/$defs/CatalogEntryBase" }],
      "type": "object",
      "required": ["kind", "material", "color"],
      "additionalProperties": false,
      "properties": {
        "catalog": true,
        "id": true,
        "version": true,
        "name": true,
        "description": true,
        "tags": true,
        "kind": { "const": "substrate" },
        "material": { "enum": ["soil", "sand", "gravel"] },
        "color": { "$ref": "#/$defs/HexColor" },
        "grainSize": { "type": "number", "exclusiveMinimum": 0 }
      }
    }
  }
}
