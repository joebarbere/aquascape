{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "ES2022",
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "paths": {
      "@aquascape/domain/catalog": ["libs/domain/catalog/src/index.ts"],
      "@aquascape/domain/document": ["libs/domain/document/src/index.ts"],
      "@aquascape/domain/fish-anatomy": ["libs/domain/fish-anatomy/src/index.ts"],
      "@aquascape/domain/geometry": ["libs/domain/geometry/src/index.ts"],
      "@aquascape/domain/growth-sim": ["libs/domain/growth-sim/src/index.ts"],
      "@aquascape/domain/livestock-ecs": ["libs/domain/livestock-ecs/src/index.ts"],
      "@aquascape/domain/scene-model": ["libs/domain/scene-model/src/index.ts"],
      "@aquascape/domain/stocking": ["libs/domain/stocking/src/index.ts"],
      "@aquascape/features/editor-shell": ["libs/features/editor-shell/src/index.ts"],
      "@aquascape/features/export": ["libs/features/export/src/index.ts"],
      "@aquascape/features/hardscape-tool": ["libs/features/hardscape-tool/src/index.ts"],
      "@aquascape/features/layers-panel": ["libs/features/layers-panel/src/index.ts"],
      "@aquascape/features/livestock-equipment": ["libs/features/livestock-equipment/src/index.ts"],
      "@aquascape/features/planting-tool": ["libs/features/planting-tool/src/index.ts"],
      "@aquascape/features/substrate-tool": ["libs/features/substrate-tool/src/index.ts"],
      "@aquascape/features/tank-setup": ["libs/features/tank-setup/src/index.ts"],
      "@aquascape/features/templates": ["libs/features/templates/src/index.ts"],
      "@aquascape/platform/platform-api": ["libs/platform/platform-api/src/index.ts"],
      "@aquascape/platform/platform-api/angular": [
        "libs/platform/platform-api/src/angular/index.ts"
      ],
      "@aquascape/platform/platform-electron": ["libs/platform/platform-electron/src/index.ts"],
      "@aquascape/platform/platform-web": ["libs/platform/platform-web/src/index.ts"],
      "@aquascape/rendering/livestock-renderer-3d": [
        "libs/rendering/livestock-renderer-3d/src/index.ts"
      ],
      "@aquascape/rendering/renderer-2d": ["libs/rendering/renderer-2d/src/index.ts"],
      "@aquascape/rendering/renderer-3d": ["libs/rendering/renderer-3d/src/index.ts"],
      "@aquascape/rendering/renderer-api": ["libs/rendering/renderer-api/src/index.ts"],
      "@aquascape/state": ["libs/state/src/index.ts"],
      "@aquascape/testing": ["libs/testing/src/index.ts"],
      "@aquascape/ui": ["libs/ui/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
